# ---------------------------------------------------------------------------
# Ember & Bean server configuration. Copy to server/.env and fill in values.
# Never commit server/.env - it holds secrets.
# ---------------------------------------------------------------------------

# Port for the API (and for the built client in production). API_PORT takes precedence over
# PORT; hosting platforms that inject PORT can leave API_PORT unset.
API_PORT=4000
NODE_ENV=development

# MongoDB connection string. Examples:
#   Local install: mongodb://127.0.0.1:27017/ember_and_bean
#   MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>/ember_and_bean?retryWrites=true&w=majority
# Leave empty in development to use the embedded MongoDB (see EMBEDDED_MONGO).
MONGODB_URI=

# When MONGODB_URI is empty, start a local MongoDB automatically (data kept in EMBEDDED_MONGO_DBPATH).
# Defaults to true outside production. The first start downloads the official mongod binary (~100 MB).
EMBEDDED_MONGO=true
EMBEDDED_MONGO_DBPATH=.data/db
EMBEDDED_MONGO_PORT=27018

# Secret used to sign admin session tokens. Required in production (32+ random characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Send cookies only over HTTPS. Defaults to true when NODE_ENV=production.
COOKIE_SECURE=false

# Comma-separated list of origins allowed to call the API with credentials (dev client).
CLIENT_ORIGIN=http://localhost:5173

# First administrator, created automatically on startup when no admin account exists yet.
# The password must be at least 10 characters. You can remove these after the first start.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Uploaded product images and .glb models.
UPLOAD_DIR=uploads
MAX_IMAGE_MB=3
MAX_MODEL_MB=20

# Seed the sample menu automatically when the database has no categories.
AUTO_SEED=true

# Set to the number of reverse proxies in front of the app (e.g. 1 behind Nginx/Render) so
# rate limiting sees the real client IP.
TRUST_PROXY=0
